ENV=development

# Supabase Postgres (with PostGIS enabled) connection string
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# JWT
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=yukti-uploads

# Gemini API (Phase 6)
GEMINI_API_KEY=

# Firebase Cloud Messaging (Phase 8) — download the service account JSON from
# Firebase Console > Project Settings > Service accounts > Generate new private key,
# save it inside the project (don't commit it), and point to it here.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
